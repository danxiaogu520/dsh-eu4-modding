{
  "name": "dsh-eu4-modding",
  "version": "0.1.2",
  "description": "ParadoxCode language intelligence and draft validation for agentic EU4 modding in DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danxiaogu520/dsh-eu4-modding.git"
  },
  "homepage": "https://github.com/danxiaogu520/dsh-eu4-modding#readme",
  "bugs": {
    "url": "https://github.com/danxiaogu520/dsh-eu4-modding/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "examples",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "paradoxcode",
    "eu4",
    "agentic-modding"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "test:integration": "tsc -p tsconfig.json && node --test test/integration/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "docs:agents": "tsc -p tsconfig.json && node scripts/generate-agents.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-package-manifest": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.0.0",
    "js-yaml": "4.3.2",
    "typescript": "~5.9.3"
  }
}
